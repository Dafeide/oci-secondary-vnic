      { "tag": "geosite-piratebay", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-piratebay.srs", "download_detour": "direct" },
      { "tag": "geosite-1337x", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-1337x.srs", "download_detour": "direct" },
