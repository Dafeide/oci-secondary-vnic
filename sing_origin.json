      { "tag": "geosite-epochmediagroup", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-epochmediagroup.srs", "download_detour": "direct" },
      { "tag": "geosite-falungong", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-falungong.srs", "download_detour": "direct" },
      { "tag": "geosite-category-pt", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-category-pt.srs", "download_detour": "direct" },
      { "tag": "geosite-category-public-tracker", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-category-public-tracker.srs", "download_detour": "direct" },
      { "tag": "geosite-category-bank-cn", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-category-bank-cn.srs", "download_detour": "direct" },
