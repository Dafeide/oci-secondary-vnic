      { "tag": "geosite-rutracker", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-rutracker.srs", "download_detour": "direct" },
      { "tag": "geosite-btdig", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-btdig.srs", "download_detour": "direct" },
      { "tag": "geosite-bttzyw", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-bttzyw.srs", "download_detour": "direct" },
      { "tag": "geosite-xunlei", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-xunlei.srs", "download_detour": "direct" }
    ],
    "final": "direct"
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    }
  }
}