{
  "dns": {
    "servers": [
      {
        "tag": "cf",
        "address": "1.1.1.1"
      }
    ],
    "strategy": "ipv4_only"
  },
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct",
      "domain_resolver": {
        "server": "cf",
        "strategy": "ipv4_only"
      }
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "ip_is_private": true,
        "outbound": "block"
      },
      {
        "protocol": [
          "bittorrent"
        ],
        "outbound": "block"
      },
      // --- 白名单开始：确保这些域名不被后面的 geosite-cn 拦截 ---
      {
        "rule_set": [
          "geosite-apple",
          "geosite-google",
          "geosite-microsoft",
          "geosite-pikpak"
        ],
        "outbound": "direct"
      },
      {
        "domain": [
          "i.hmoe.link"
        ],
        "outbound": "direct"
      },
      // --- 白名单结束 ---
      {
        "domain_regex": [
          "(api|ps|sv|offnavi|newvector|ulog.imap|newloc)(.map|).(baidu|n.shifen).com",
          "(.+.|^)(360|so).(cn|com)",
          "(Subject|HELO|SMTP)",
          "(torrent|.torrent|peer_id=|info_hash|get_peers|find_node|BitTorrent|announce_peer|announce.php?passkey=)",
          "(.@)(guerrillamail|guerrillamailblock|sharklasers|grr|pokemail|spam4|bccto|chacuo|027168).(info|biz|com|de|net|org|me|la)",
          "(xunlei|sandai|Thunder|XLLiveUD)",
          "(dafahao|mingjinglive|botanwang|minghui|dongtaiwang|falunaz|epochtimes|ntdtv|falundafa|falungong|wujieliulan|zhengjian).(org|com|net)",
          "(ed2k|.torrent|peer_id=|announce|info_hash|get_peers|find_node|BitTorrent|announce_peer|announce.php?passkey=|magnet:|xunlei|sandai|Thunder|XLLiveUD|bt_key)",
          "(.+.|^)(360).(cn|com|net)",
          "(guanjia.qq.com|qqpcmgr|QQPCMGR)",
          "(rising|kingsoft|duba|xindubawukong|jinshanduba).(com|net|org)",
          "(netvigator|torproject).(com|cn|net|org)",
          "(visa|mycard|gash|beanfun|bank).",
          "(gov|12377|12315|talk.news.pts.org|creaders|zhuichaguoji|efcc.org|cyberpolice|aboluowang|tuidang|epochtimes|zhengjian|110.qq|mingjingnews|inmediahk|xinsheng|breakgfw|chengmingmag|jinpianwang|qi-gong|mhradio|edoors|renminbao|soundofhope|xizang-zhiye|bannedbook|ntdtv|12321|secretchina|dajiyuan|boxun|chinadigitaltimes|dwnews|huaglad|oneplusnews|epochweekly|cn.rfi).(cn|com|org|net|club|fr|tw|hk|eu|info|me)",
          "(miaozhen|cnzz|talkingdata|umeng).(cn|com)",
          "(mycard).(com|tw)",
          "(gash).(com|tw)",
          "bank",
          "(pincong).(rocks)",
          "(taobao).(com)",
          "(laomoe|jiyou|ssss|lolicp|vv1234|0z|4321q|868123|ksweb|mm126).(com|cloud|fun|cn|gs|xyz|cc)",
          "(flows|miaoko).(pages).(dev)"
        ],
        "outbound": "block"
      },
      {
        "rule_set": [
          "geosite-ucloud",
          "geosite-epochmediagroup",
          "geosite-falungong",
          "geosite-category-pt",
          "geosite-category-public-tracker",
          "geosite-category-bank-cn",
          "geosite-trackernetwork",
          "geosite-rarbg",
          "geosite-piratebay",
          "geosite-1337x",
          "geosite-nyaa",
          "geosite-rutracker",
          "geosite-btdig",
          "geosite-bttzyw",
          "geosite-xunlei"
        ],
        "outbound": "block"
      },
      {
        "domain_keyword": [
          "rarbg",
          "piratebay",
          "1337x",
          "rutracker"
        ],
        "outbound": "block"
      },
      {
        "rule_set": [ "geosite-cn", "geoip-cn" ],
        "outbound": "block"
      },
      {
        "port": [
          23, 24, 25, 107, 194, 445, 465, 587, 992, 3389
        ],
        "outbound": "block"
      },
      {
        "port_range": [
          "5231:7999",
          "9091:10000"
        ],
        "outbound": "block"
      }
    ],
    "rule_set": [
      { "tag": "geoip-cn", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs", "download_detour": "direct" },
      { "tag": "geosite-cn", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs", "download_detour": "direct" },
      { "tag": "geosite-apple", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-apple.srs", "download_detour": "direct" },
      { "tag": "geosite-google", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-google.srs", "download_detour": "direct" },
